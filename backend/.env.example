DATABASE_URL=postgresql+psycopg://voicecrm:voicecrm@localhost:5432/voicecrm
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
MAX_AUDIO_MB=50

# Sarvam AI (speech-to-text only) — https://docs.sarvam.ai/
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_STT_MODEL=saaras:v3

# AWS Bedrock (form-filling extraction) — relies on the default boto3 credential
# chain, so make sure AWS creds are configured (env vars, ~/.aws/credentials, or an
# instance profile) with bedrock:InvokeModel access to the model below.
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5

# =====================================================================
# Microsoft SSO (auth_service/)
# =====================================================================
# demo = fake login for testing (localhost only) | microsoft = real Microsoft login
AUTH_MODE=demo

# ---- Fill these when IT gives you the details, then set AUTH_MODE=microsoft ----
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
# Must EXACTLY match a Redirect URI registered in Azure. Use the address you type in the browser:
#   http://localhost:8000/... when running the built site through FastAPI (npm run build)
#   http://localhost:5173/... when running the Vite dev server (npm run dev)
REDIRECT_URI=http://localhost:8000/auth/callback
POST_LOGOUT_REDIRECT_URI=http://localhost:8000/login

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-in-production
# Set to true once the site runs on HTTPS
COOKIE_SECURE=false

# Where people land after login (a page of the React app)
APP_LANDING_URL=/voice

# Optional: address of the official DataPhi logo image for the login page
LOGO_URL=/site-logo.svg
